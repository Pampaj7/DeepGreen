### IDE ###
.vscode/
.idea/
/.metadata/

### Build output ###
# The submitted package had "0.0**rust/target/", a malformed pattern that
# matched nothing, so 1557 Rust build artifacts were tracked.
rust/target/
cpp/build*/
cpp/tools/libtorch/
cpp/tools/json_reader/
Java/deepgreen-dl4j/target/
**/__pycache__/
*.pyc

### Environments ###
.venv*/
venv/
.Rproj.user/

### Generated artefacts (reproducible; do not commit) ###
# Shared TorchScript modules: regenerate with
#   python3 scripts/export_torchscript_models.py
models/*.pt
# Datasets: regenerate with dataloader/*.py
data/*_png/
data/cifar-100-python*
data/FashionMNIST/
data/tiny-imagenet-200*
# Replicated-campaign output: 13,000 files and 54 MB, one CodeCarbon CSV per
# measured block. Not distributed -- scripts/consolidate_raw.py rewrites the
# identical records as four gzipped tables under results/replication/, which
# are committed.
results/campaign_v2/
# The accelerator-saturation cell (spec S7), likewise: its records are under
# results/replication_saturation/ (scripts/consolidate_raw.py --campaign
# saturation), which is committed.
results/campaign_saturation/
# Model checkpoints
checkpoints/
**/checkpoints/
*.pt
# Rust VarStore checkpoints, written next to the binary that produced them
*.ot
!models/MANIFEST.txt
**.h5

### Manuscript ###
# LaTeX build noise
paper/*.log
paper/*.abs
paper/*.aux
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.synctex.gz
# The same for the EMSE front end, and the staging copy of its source package
# (paper/emse/make_submission.sh rebuilds it, and the zip, on every build).
paper/emse/*.log
paper/emse/*.aux
paper/emse/*.out
paper/emse/*.bbl
paper/emse/*.blg
paper/emse/*.synctex.gz
paper/emse/submission/
# The rejection letter: a private editorial communication that names a
# co-author's address. Kept locally, not published with the repository.
paper/reviewer.tex
# Author photographs are not distributed with the source. The manuscript wraps
# \bio in \IfFileExists, so it builds without them and typesets the photograph
# if you drop the file in.
paper/bio/
# cas-dc icon assets ship with Elsevier's template bundle, not with the class;
# build.sh generates stand-ins.
paper/thumbnails/
# Calibration re-execution: a third window used only to bound between-window
# drift. Same shape as campaign_v2/ and equally not distributed; the comparison
# it feeds is in results/revision/tables/v2_window_calibration.*
results/calibration/

# Output of an analysis run against a campaign still in flight. Real, useful for
# monitoring, and not the manuscript's inputs -- see common.tables_dir.
results/revision/tables_partial/
paper/figures_partial/
paper/generated_partial/
results/gpu_utilisation.csv
